# Local dev: matches root docker-compose.yml. In prod (Neon), DATABASE_URL is
# the pooled connection string and DIRECT_URL is the direct one (required for
# `prisma migrate`); locally there is no pooler, so both can be identical.
DATABASE_URL="postgresql://dataroom:dataroom@localhost:5432/dataroom"
DIRECT_URL="postgresql://dataroom:dataroom@localhost:5432/dataroom"

PORT=4000
NODE_ENV=development

# Generate a real secret for your local .env, e.g.: openssl rand -base64 48
JWT_SECRET="replace-with-a-random-string-at-least-32-characters-long"

# From your Supabase project (Project Settings > API Keys). Use the SECRET key
# (sb_secret_... , or the legacy service_role JWT), never the publishable one:
# signing uploads for a private bucket needs privileges the publishable key
# does not have. Server-only - it must never reach the frontend.
# The bucket itself must exist and be private; every read is a signed URL.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="replace-with-the-secret-key"
SUPABASE_BUCKET="dataroom-dev"
