# Supabase Postgres (Connect -> ORMs -> Prisma gives both lines filled in).
# DATABASE_URL goes through the transaction pooler; `pgbouncer=true` tells
# Prisma to skip prepared statements, which that pooler does not support.
# DIRECT_URL uses the session pooler because migrations cannot run through the
# transaction one. URL-encode any special characters in the password.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres"

# Prefer a local database instead? Run `docker compose up -d` and use these for
# both variables - there is no pooler locally, so they are identical:
# DATABASE_URL="postgresql://dataroom:dataroom@localhost:5432/dataroom"
# DIRECT_URL="postgresql://dataroom:dataroom@localhost:5432/dataroom"

PORT=4000
NODE_ENV=development

# Generate a real secret for your local .env, e.g.: openssl rand -base64 48
JWT_SECRET="replace-with-a-random-string-at-least-32-characters-long"

# From your Supabase project (Project Settings > API Keys). Use the SECRET key
# (sb_secret_... , or the legacy service_role JWT), never the publishable one:
# signing uploads for a private bucket needs privileges the publishable key
# does not have. Server-only - it must never reach the frontend.
# The bucket itself must exist and be private; every read is a signed URL.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="replace-with-the-secret-key"
SUPABASE_BUCKET="dataroom-dev"
