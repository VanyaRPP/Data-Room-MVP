// Data Room MVP — core schema.
// Design decisions are explained in the root README ("Design decisions" /
// "How it scales"); this file documents only what isn't obvious from the
// model shapes themselves.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // Neon's pooled connection string (DATABASE_URL) can't run migrations;
  // directUrl is the unpooled one `prisma migrate` needs. Locally, with a
  // single docker-compose Postgres, both env vars point at the same URL.
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())

  dataRooms   DataRoom[]
  shareGrants ShareGrant[]
  shares      Share[]      @relation("ShareCreator")
}

model DataRoom {
  id        String   @id @default(uuid())
  name      String
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id])
  createdAt DateTime @default(now())

  // Every room gets exactly one root FOLDER node at creation time; all other
  // nodes have a non-null parentId. That keeps "is this node a root" a single
  // null-check instead of a separate flag, and lets the sibling-name unique
  // index (see migration.sql) treat every non-root node uniformly.
  rootNodeId String? @unique
  nodes      Node[]

  @@index([ownerId])
}

enum NodeType {
  FOLDER
  FILE
}

enum FileStatus {
  UPLOADING
  READY
}

model Node {
  id       String   @id @default(uuid())
  roomId   String
  room     DataRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  parentId String?
  parent   Node?    @relation("Tree", fields: [parentId], references: [id], onDelete: Cascade)
  children Node[]   @relation("Tree")

  type NodeType
  name String

  // FILE-only fields:
  size       BigInt?
  mimeType   String?
  storageKey String?     @unique
  status     FileStatus? // UPLOADING until /files/:id/complete confirms the upload, then READY

  // Running totals for everything *below* this node, so a folder can show its
  // size without a recursive query per row. Maintained inside the same
  // transaction as any write that changes them - see SubtreeCountersService,
  // and the reconciliation test that proves they still match the CTE.
  subtreeBytes   BigInt @default(0)
  subtreeFiles   Int    @default(0)
  subtreeFolders Int    @default(0)

  // The node always holds the *current* version, so listings need no join.
  // Superseded versions are archived as FileVersion rows numbered 1..version-1.
  version Int @default(1)
  // Where a replacement version's bytes are being uploaded to. Cleared once
  // /complete promotes them; a failed upload just leaves it to be overwritten.
  pendingStorageKey String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shares   Share[]
  versions FileVersion[]

  @@index([parentId])
  @@index([roomId])
}

/// A superseded version of a file. The current one lives on Node itself, so
/// reading a folder never joins this table; it is only consulted when someone
/// asks for a file's history.
model FileVersion {
  id     String @id @default(uuid())
  nodeId String
  node   Node   @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  version    Int
  size       BigInt
  mimeType   String
  storageKey String @unique

  createdAt DateTime @default(now())

  @@unique([nodeId, version])
  @@index([nodeId])
}

enum ShareMode {
  PUBLIC // anyone with the link
  RESTRICTED // only users with a matching ShareGrant
}

model Share {
  id          String    @id @default(uuid())
  nodeId      String
  node        Node      @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  mode        ShareMode
  // Set explicitly by SharesService from 32 random bytes (256 bits) - a share
  // link is a bearer credential, so it has to be far beyond guessable. The
  // cuid2 default is only a backstop for rows created outside that path; it is
  // unpredictable too, but at ~124 bits it sits just under the bar.
  token       String    @unique @default(cuid(2))
  createdById String
  createdBy   User      @relation("ShareCreator", fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
  revokedAt   DateTime?

  grants ShareGrant[]

  @@index([nodeId])
}

enum ShareRole {
  VIEWER
  // EDITOR is deliberately left out of the MVP (only VIEWER is enforced) but
  // kept as an enum member so adding it later is a permission-map change in
  // AccessService, not a schema migration. See README "How it scales".
}

model ShareGrant {
  id      String    @id @default(uuid())
  shareId String
  share   Share     @relation(fields: [shareId], references: [id], onDelete: Cascade)
  email   String // granted by email so it works for not-yet-registered users too
  userId  String?
  user    User?     @relation(fields: [userId], references: [id])
  role    ShareRole @default(VIEWER)

  @@unique([shareId, email])
}
